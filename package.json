{
  "name": "dressesbygreta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply greta --local",
    "seed": "uv run --with pillow python tools/seed.py",
    "admin:password": "node tools/admin-password.mjs",
    "deploy": "npm run build && wrangler d1 migrations apply greta --remote && wrangler deploy"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.136.3"
  }
}
