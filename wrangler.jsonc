{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  // The business's own Cloudflare account (dressesbygreta@gmail.com), since 2026-10-02.
  "account_id": "52d9dbd2e2f6859693a3c45a2fed6ad5",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // Local development runs against simulated D1 and KV (.wrangler/state); deploys use the real ones.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greta",
      "database_id": "7a908f6d-1f2d-4741-8ee7-6537e04a94a8",
      "migrations_dir": "migrations"
    }
  ],
  // Photographs live in Workers KV (the store in src/worker/images.ts is the only code that
  // touches it, so moving to R2 later is one file).
  "kv_namespaces": [{ "binding": "PHOTOS", "id": "06a8ae884d5e4bc582c3b96280b20f36" }],
  // Releases stock held by card orders that were never paid.
  "triggers": { "crons": ["*/15 * * * *"] },
  "workers_dev": true,
  "preview_urls": false
}
